# =============================================================================
# Dockerfile.cn-base  —  Mainland-China network ready base layer (COPY-PASTE)
# =============================================================================
# This file is NOT built directly. Copy the blocks you need into your
#   Dockerfile  right AFTER the first FROM line and BEFORE any package install.
#
# Design notes:
#   * Every block is idempotent and tolerant of missing files (Debian vs Ubuntu
#     vs Alpine, deb822 vs legacy sources.list).
#   * Never hardcode a registry mirror here — the host daemon / BuildKit
#     mirrors should handle image names. This file only handles IN-CONTAINER
#     package sources.
#   * Keep `DEBIAN_FRONTEND=noninteractive` at image level so apt never blocks.
#   * On Windows hosts, ensure copied `.sh` or wrapper files use LF line
#     endings (`*.sh text eol=lf` in `.gitattributes`), or normalize via
#     `sed -i 's/\r$//'` inside the image before running.
# =============================================================================


# -----------------------------------------------------------------------------
# BLOCK A — Debian / Ubuntu: switch APT to a domestic mirror, both formats
# -----------------------------------------------------------------------------
# Handles:
#   - Debian 12+ / Ubuntu 24.04+ deb822  (/etc/apt/sources.list.d/*.sources)
#   - Legacy one-line format            (/etc/apt/sources.list)
#   - Keeps security/backports suites working after the host swap
ARG APT_MIRROR=mirrors.aliyun.com
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8

RUN set -eux; \
    if [ -d /etc/apt ]; then \
      # --- deb822 (.sources) ------------------------------------------------
      if ls /etc/apt/sources.list.d/*.sources >/dev/null 2>&1; then \
        sed -i -E "s#(deb\.debian\.org|security\.debian\.org|archive\.ubuntu\.com|security\.ubuntu\.com|ports\.ubuntu\.com)#${APT_MIRROR}#g" \
            /etc/apt/sources.list.d/*.sources; \
      fi; \
      # --- legacy one-line sources -----------------------------------------
      if [ -f /etc/apt/sources.list ]; then \
        sed -i -E "s#(deb\.debian\.org|security\.debian\.org|archive\.ubuntu\.com|security\.ubuntu\.com|ports\.ubuntu\.com)#${APT_MIRROR}#g" \
            /etc/apt/sources.list; \
      fi; \
      # --- bootstrap CA so HTTPS mirrors work in minimal images ------------
      if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then \
        apt-get -o Acquire::Retries=5 update || true; \
        apt-get -y -o Acquire::Retries=5 --no-install-recommends install ca-certificates || true; \
      fi; \
      apt-get -o Acquire::Retries=5 update; \
    fi


