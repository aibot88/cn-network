# -----------------------------------------------------------------------------
# BLOCK I — Healthcheck that works in minimal images
# -----------------------------------------------------------------------------
# Avoid `curl` in HEALTHCHECK when the base image has no curl:
#   HEALTHCHECK --interval=5s --timeout=3s --retries=30 \
#     CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
